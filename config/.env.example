# Telegram Bot Credentials
# Dapatkan bot token dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Dapatkan chat ID tujuan dari @userinfobot atau kirim pesan ke bot lalu cek updates
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Mode Aplikasi: development / production
APP_ENV=development

# Database path (opsional, default: data/stock_data.db)
DATABASE_PATH=data/stock_data.db
