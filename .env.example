# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Mode Aplikasi
APP_ENV=production
DATABASE_PATH=data/bot_database.db

# Crypto Trading Credentials (Binance Spot)
CRYPTO_EXCHANGE=binance
CRYPTO_API_KEY=your_binance_api_key_here
CRYPTO_SECRET_KEY=your_binance_secret_key_here

# Auto-Pump Sniper Settings (Binance Spot)
AUTOPUMP_MODE=live
AUTOPUMP_AUTO_START=false
AUTOPUMP_CAPITAL_PER_COIN=15.0
AUTOPUMP_MAX_POSITIONS=3
AUTOPUMP_MIN_SCORE=75
CRYPTO_MAX_DAILY_LOSS=10.0

# Google Gemini AI Brain Gatekeeper
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
AI_MIN_SCORE=80
